# Optional overrides for the test suite. Copy to tests/.env.test (git-ignored).
# Nothing here is required: by default the suite uses the PostgreSQL server from
# backend/.env with a separate database named <your db>_test (e.g. ers_db_test).

# Full URL of the TEST database. Its name must end in "_test"; the suite refuses anything else
# and refuses the database named in backend/.env.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ers_db_test

# Port of the backend the tests start (your own backend on :8000 can keep running).
# TEST_BACKEND_PORT=8001
# Port for the short-lived backend used by the rate-limit tests.
# TEST_FRESH_BACKEND_PORT=8002

# Angular dev server used by the browser (e2e) tests.
# TEST_FRONTEND_URL=http://localhost:4200
