# Copy this file to .env and fill it in. .env is in .gitignore: never commit it.
# The server refuses to start if DATABASE_URL or JWT_SECRET_KEY is missing.

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ers_db

# Signs login tokens and CSRF tokens. At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out.
JWT_SECRET_KEY=

# Google reCAPTCHA v2 secret key (https://www.google.com/recaptcha/admin/create).
# The site key goes in the frontend. Google's test keys always pass: use real keys in production.
RECAPTCHA_SECRET_KEY=

# --- Security settings (defaults suit local development) ---
# Where the Angular app runs: used for CORS, the CSRF Origin check and email links
# FRONTEND_URL=http://localhost:4200
# Extra allowed origins, comma separated (default: FRONTEND_URL and http://127.0.0.1:4200)
# ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# true when served over HTTPS: Secure cookies, HSTS, and HTTP is redirected to HTTPS
# HTTPS_ONLY=false
# Interactive API docs at /docs (turn off in production)
# ENABLE_API_DOCS=true
# Print every SQL query with its parameters (includes password hashes: keep off)
# SQL_ECHO=false

# Email (SMTP) - EMAIL_ENABLED=false skips all outgoing mail
# Gmail: use an App Password (myaccount.google.com -> App passwords), not your normal password
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-address@gmail.com
FROM_NAME=EVEREST Event System

# Optional: send through Brevo's HTTPS API instead of SMTP (works on networks that
# block ports 587/465, like campus Wi-Fi). When set, SMTP_* is ignored.
# FROM_EMAIL must be added as a verified sender in Brevo (Senders & IP -> Senders).
# BREVO_API_KEY=xkeysib-...
